model Venue {
  id           Int      @id @default(autoincrement())
  name         String
  location     String
  capacity     Int
  type         String
  price        Float
  availability Boolean  @default(true)

  modelUrl     String?
  layoutData   String?

  // Real-world venue dimensions in metres.
  width        Float    @default(12)
  depth        Float    @default(12)

  // Optional irregular usable-floor polygon as JSON points.
  // Example: [{"x": -5, "z": -4}, {"x": 5, "z": -4}, ...]
  boundaryData String?

  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model InventoryItem {
  id                Int      @id @default(autoincrement())

  name              String
  category          String

  modelUrl          String
  imageUrl          String?

  width             Float
  depth             Float
  height            Float

  quantity          Int
  availableQuantity Int

  price             Float

  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
}
