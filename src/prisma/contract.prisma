// use prisma-next

model Venue {
  id           Int      @id @default(autoincrement())
  name         String
  location     String
  capacity     Int
  type         String
  price        Float
  availability Boolean  @default(true)
  modelUrl     String?
  layoutData   String?
  createdAt    TimestamptzString @default(now())
  updatedAt    temporal.updatedAtString()
}

model InventoryItem {
  id                Int      @id @default(autoincrement())
  name              String
  category          String

  modelUrl          String
  imageUrl          String?

  width             Float
  depth             Float
  height            Float

  quantity          Int
  availableQuantity Int

  price             Float

  createdAt         TimestamptzString @default(now())
  updatedAt         temporal.updatedAtString()
}

model ClientRequirement {
  id           Int      @id @default(autoincrement())

  budget       Float
  createdAt    TimestamptzString @default(now())

  decoration   String?
  eventDate    TimestamptzString
  eventType    String
  guests       Int
  location     String
  requirements String?
  seating      String?

  updatedAt    temporal.updatedAtString()
}

model Theme {
  id              Int      @id @default(autoincrement())

  name            String
  description     String?

  primaryColor    String
  secondaryColor  String

  decorationStyle String

  createdAt       TimestamptzString @default(now())
  updatedAt       temporal.updatedAtString()
}
model SavedDesign {
  id           Int      @id @default(autoincrement())

  name         String

  venueId      Int

  themeId      Int?

  layoutData   String

  createdAt    TimestamptzString @default(now())
  updatedAt    temporal.updatedAtString()
}